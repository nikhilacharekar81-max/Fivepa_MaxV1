# JWT_SECRET: Required in production (minimum 32 characters, high-entropy, non-placeholder; minimum 16 characters in development).
JWT_SECRET=""

# GATEWAY_ENCRYPTION_KEY: Required in production (minimum 16 characters, must be distinct from JWT_SECRET).
GATEWAY_ENCRYPTION_KEY=""

# DATABASE_URL: Required in production for remote PostgreSQL connection (uses embedded PGlite in local development if omitted).
DATABASE_URL=""

# APP_URL: Public base URL where the application is hosted (used for self-referential links, webhooks, and redirects).
APP_URL="http://localhost:3000"

# RESEND_API_KEY: Optional in development, required in production to send real verification and recovery emails via Resend.
RESEND_API_KEY=""

# EMAIL_FROM: Configured sender address for outgoing emails (e.g. "WorkPerHour <notifications@yourdomain.com>").
EMAIL_FROM=""

# GCS_BUCKET_NAME: Optional in development, required in production for Google Cloud Storage persistence.
GCS_BUCKET_NAME=""

# PAYMENT_SIMULATION_ENABLED: Set to "true" only in non-production environments to allow simulated payment gateway checkouts.
PAYMENT_SIMULATION_ENABLED="false"

# TRUST_PROXY: Controls whether X-Forwarded-For headers from private/loopback proxy peers are trusted ("true" or "false").
TRUST_PROXY="true"

# ALLOW_DATA_RESET: Must never be enabled in production unless explicitly performing an authorized administrative reset ("false").
ALLOW_DATA_RESET="false"

# USER_DEVICE_VERIFICATION: Optional boolean ("true" / "false") to enable new-device login verification prompts for non-admin users.
USER_DEVICE_VERIFICATION="false"

# GEMINI_API_KEY: Optional AI Studio environment variable (injected automatically by AI Studio if configured).
GEMINI_API_KEY=""
